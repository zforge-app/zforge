      "ZforgeUITests/ZforgeUITests/testArchiveDragCopiesIntoSidebarFolder": "drag and drop session through the window server",
      "ZforgeUITests/ZforgeUITests/testArchiveCopyIntoAnotherZforgeWindow": "drag and drop session through the window server",
      "ZforgeUITests/ZforgeUITests/testLocalDragsOptionCopyAndConfirmAdditionToArchive": "drag and drop session through the window server",
      "ZforgeUITests/ZforgeUITests/testArchiveInternalCopyConfirmationKeepsHistoryAndAncestorColumns": "drag and drop session through the window server",
      "ZforgeUITests/ZforgeUITests/testListHeaderDividerResizesAndHeaderBodyReorders": "the header reorder is a drag and drop session through the window server",
