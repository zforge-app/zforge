{
  "description": "Maps changed paths to the UI tests they can affect. Scripts/affected-tests.py applies it; the Unit plan always runs in full. Paths are fnmatch globs relative to the project root ('*' also matches '/').",
  "ignore": [
    "*.md",
    "Documentation/*",
    "Scripts/*",
    "TestPlans/*",
    "ZforgeSnapshots/*",
    "Zforge/Assets.xcassets/*",
    "Zforge/zforge_icon.icon/*",
    "Zforge/Resources/*",
    "Zforge.xcodeproj/xcuserdata/*",
    "Zforge.xcodeproj/xcshareddata/*",
    ".gitignore",
    "*.DS_Store"
  ],
  "rules": [
    {
      "name": "Shared state and models: semantics are proven by the Unit plan; UI-Smoke checks the interaction wiring in every layer",
      "paths": [
        "Zforge/State/*",
        "Zforge/Models/BrowserModels.swift",
        "Zforge/Models/FileBrowserPreferences.swift",
        "Zforge/Services/UIFixtureServices.swift",
        "Shared/BrowserSelectionAction.swift",
        "Zforge/Services/FileSystemService.swift",
        "Zforge/Services/RecentItemsService.swift",
        "Zforge/Services/UserDirectoryService.swift",
        "Zforge/Services/VolumeService.swift",
        "Zforge/Services/DirectoryMonitor.swift",
        "Zforge/Services/AccessGrantStore.swift",
        "Zforge/Services/PinnedFolderStore.swift"
