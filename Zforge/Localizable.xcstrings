        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Archiv wurde seit dem Öffnen geändert. Öffne es erneut, bevor du Objekte entfernst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive changed since it was opened. Reopen it before removing items."
          }
        },
