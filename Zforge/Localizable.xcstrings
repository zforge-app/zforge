          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo comprimido ha cambiado desde que se abrió. Ábrelo de nuevo antes de eliminar ítems."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’archive a changé depuis son ouverture. Rouvrez-la avant de supprimer des éléments."
