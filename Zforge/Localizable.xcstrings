        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un élément d’un bloc solide est mesuré selon la taille compressée de son bloc."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सॉलिड ब्लॉक के किसी आइटम को उसके ब्लॉक के संपीड़ित आकार से मापा जाता है।"
