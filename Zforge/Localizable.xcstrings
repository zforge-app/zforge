    "An item in a solid block is measured by the compressed size of its block." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সলিড ব্লকের কোনো আইটেম তার ব্লকের সংকুচিত আকার দিয়ে মাপা হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položka v pevném bloku se měří komprimovanou velikostí svého bloku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et emne i en solid blok måles efter den komprimerede størrelse af dets blok."
