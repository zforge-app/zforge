          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুন ZIP বা 7z আর্কাইভ তৈরি করুন। অনুরোধ করা হলে উৎস ও গন্তব্য ফোল্ডারের অনুমতি দিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte nový archiv ZIP nebo 7z. Při zobrazení výzvy povolte přístup ke zdrojové a cílové složce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret et nyt ZIP- eller 7z-arkiv. Tillad adgang til kilde- og destinationsmapper, når du bliver bedt om det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle ein neues ZIP- oder 7z-Archiv. Erlaube den Zugriff auf Quell- und Zielordner, wenn du dazu aufgefordert wirst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a new ZIP or 7z archive. Authorize source and destination folders when requested."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un archivo ZIP o 7z. Autoriza las carpetas de origen y destino cuando se te solicite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez une archive ZIP ou 7z. Autorisez les dossiers source et de destination lorsque cela vous est demandé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नया ZIP या 7z आर्काइव बनाएँ। अनुरोध किए जाने पर स्रोत और गंतव्य फ़ोल्डर की अनुमति दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un nuovo archivio ZIP o 7z. Autorizza le cartelle di origine e destinazione quando richiesto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい ZIP または 7z アーカイブを作成します。求められた場合は、コピー元と保存先のフォルダへのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 ZIP 또는 7z 압축 파일을 생성합니다. 요청 시 원본 및 대상 폴더에 접근 권한을 부여하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een nieuw ZIP- of 7z-archief. Geef toestemming voor de bron- en doelmappen wanneer daarom wordt gevraagd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz nowe archiwum ZIP lub 7z. Gdy pojawi się żądanie, zezwól na dostęp do folderów źródłowego i docelowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie um novo arquivo ZIP ou 7z. Autorize as pastas de origem e destino quando solicitado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте архив ZIP или 7z. При запросе разрешите доступ к исходной папке и папке назначения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapa ett nytt ZIP- eller 7z-arkiv. Ge åtkomst till käll- och målmapparna när du blir tillfrågad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างไฟล์บีบอัด ZIP หรือ 7z ใหม่ อนุญาตโฟลเดอร์ต้นทางและปลายทางเมื่อมีการร้องขอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni ZIP veya 7z arşivi oluşturun. İstendiğinde kaynak ve hedef klasörlere izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створіть архів ZIP або 7z. Коли з’явиться запит, дозвольте доступ до початкової та цільової папок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建新的 ZIP 或 7z 压缩文件。出现提示时，请授权访问源文件夹和目标文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立新的 ZIP 或 7z 壓縮檔案。出現提示時，請授權取用源資料夾和目標資料夾。"
          }
        }
      }
    },
