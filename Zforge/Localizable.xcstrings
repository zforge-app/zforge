            "value" : "Udpakning af %@ kan kræve mere end 1 GB midlertidig diskplads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Entpacken von %@ kann mehr als 1 GB temporärer Speicherplatz erforderlich sein."
