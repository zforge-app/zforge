    "Choose the columns shown by default. Drag them to change their order. A folder can override this layout from a column header." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিফল্টভাবে দেখানো কলাম বেছে নিন। টেনে এনে তাদের ক্রম বদলান। কোনও ফোল্ডারে কলামের শিরোনাম থেকে এই বিন্যাস বদলানো যায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte sloupce, které se mají standardně zobrazovat. Jejich pořadí změníte přetažením. Pro jednotlivou složku lze rozvržení upravit ze záhlaví sloupce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg de kolonner, der vises som standard. Træk dem for at ændre rækkefølgen. En mappe kan tilsidesætte dette layout via en kolonneoverskrift."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die standardmäßig angezeigten Spalten. Ändere ihre Reihenfolge durch Ziehen. Ein Ordner kann dieses Layout über einen Spaltenkopf überschreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the columns shown by default. Drag them to change their order. A folder can override this layout from a column header."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige las columnas que se muestran por omisión. Arrástralas para cambiar su orden. Cada carpeta puede sustituir esta disposición desde una cabecera de columna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les colonnes affichées par défaut. Faites-les glisser pour modifier leur ordre. Un dossier peut remplacer cette disposition depuis un en-tête de colonne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिफ़ॉल्ट रूप से दिखाए जाने वाले कॉलम चुनें। उनका क्रम बदलने के लिए उन्हें खींचें। किसी फ़ोल्डर में कॉलम के शीर्षक से यह लेआउट बदला जा सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli le colonne mostrate di default. Trascinale per cambiarne l’ordine. Una cartella può sostituire questa disposizione dall’intestazione di una colonna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトで表示する列を選択し、ドラッグして順序を変更します。列の見出しからフォルダごとのレイアウトを設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 표시할 열을 선택하십시오. 드래그하여 순서를 변경할 수 있습니다. 각 폴더의 열 머리글에서 이 구성을 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de kolommen die standaard worden getoond. Sleep ze om de volgorde te wijzigen. Een map kan deze indeling via een kolomkop vervangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz domyślnie wyświetlane kolumny. Zmieniaj ich kolejność, przeciągając je. Folder może mieć własny układ ustawiony z poziomu nagłówka kolumny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha as colunas exibidas por padrão. Arraste-as para alterar a ordem. Uma pasta pode personalizar este layout pelo cabeçalho de uma coluna."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите столбцы, отображаемые по умолчанию. Меняйте их порядок перетаскиванием. Для отдельной папки можно изменить расположение через заголовок столбца."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj vilka kolumner som visas som standard. Ändra ordningen genom att dra dem. En mapp kan ersätta den här layouten från en kolumnrubrik."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกคอลัมน์ที่แสดงตามค่าเริ่มต้น ลากเพื่อเปลี่ยนลำดับ แต่ละโฟลเดอร์สามารถเปลี่ยนเค้าโครงนี้ได้จากหัวคอลัมน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saptanmış olarak gösterilecek sütunları seçin. Sıralarını değiştirmek için sürükleyin. Bir klasörde bu düzen sütun başlığından değiştirilebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть стовпці, які відображатимуться типово. Змінюйте їхній порядок перетягуванням. Для окремої папки можна змінити цей макет через заголовок стовпця."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选取默认显示的列。拖移以调整顺序。可通过列标题为单个文件夹设置不同布局。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取預設顯示的列。拖移以調整順序。可透過列標題為單個資料夾設定不同佈局。"
          }
        }
      }
    },
    "Choose the items shown in the sidebar Locations and Shared sections." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাইডবারের লোকেশন ও শেয়ার করা অংশে দেখানো আইটেমগুলো বেছে নিন।"
