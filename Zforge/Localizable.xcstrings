    "Extract creates a folder named after the archive, next to it. You can change this choice in Settings ▸ General." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এক্সট্র্যাক্ট করলে আর্কাইভের পাশে তার নামে একটি ফোল্ডার তৈরি হয়। আপনি এই পছন্দটি সেটিংস ▸ সাধারণ-এ পরিবর্তন করতে পারেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozbalení vytvoří vedle archivu složku s jeho názvem. Tuto volbu můžete změnit v Nastavení ▸ Obecné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udpakning opretter en mappe med arkivets navn ved siden af det. Du kan ændre dette valg i Indstillinger ▸ Generelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Entpacken wird neben dem Archiv ein Ordner mit seinem Namen erstellt. Du kannst diese Auswahl unter „Einstellungen“ ▸ „Allgemein“ ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extract creates a folder named after the archive, next to it. You can change this choice in Settings ▸ General."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extraer crea una carpeta con el nombre del archivo comprimido, junto a él. Puedes cambiar esta opción en Ajustes ▸ General."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extraire crée un dossier portant le nom de l’archive, à côté de celle-ci. Vous pouvez modifier ce choix dans Réglages ▸ Général."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक्सट्रैक्ट करने पर आर्काइव के बगल में उसके नाम का एक फ़ोल्डर बनता है। आप यह विकल्प सेटिंग्ज़ ▸ सामान्य में बदल सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrai crea una cartella con il nome dell’archivio, accanto a esso. Puoi modificare questa scelta in Impostazioni ▸ Generali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展開すると、アーカイブの横に同じ名前のフォルダが作成されます。この選択は“設定”▸“一般”で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "압축을 풀면 압축 파일 옆에 같은 이름의 폴더가 생성됩니다. 이 선택은 설정 ▸ 일반에서 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitpakken maakt naast het archief een map met de naam van het archief. Je kunt deze keuze wijzigen in Instellingen ▸ Algemeen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpakowanie tworzy obok archiwum folder o jego nazwie. Ten wybór możesz zmienić w Ustawieniach ▸ Ogólne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrair cria uma pasta com o nome do arquivo compactado, ao lado dele. Você pode mudar essa escolha em Ajustes ▸ Geral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При распаковке рядом с архивом создается папка с его именем. Этот выбор можно изменить в разделе «Настройки» ▸ «Основные»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppackning skapar en mapp med arkivets namn bredvid det. Du kan ändra valet i Inställningar ▸ Allmänt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การคลายไฟล์จะสร้างโฟลเดอร์ที่ตั้งชื่อตามไฟล์บีบอัดไว้ข้างๆ คุณสามารถเปลี่ยนตัวเลือกนี้ได้ในการตั้งค่า ▸ ทั่วไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arşivden çıkarma, arşivin yanında onun adını taşıyan bir klasör oluşturur. Bu seçimi Ayarlar ▸ Genel bölümünden değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розпакування створює поруч з архівом папку з його назвою. Цей вибір можна змінити в розділі «Параметри» ▸ «Загальні»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解压会在压缩文件旁边创建一个以其命名的文件夹。你可以在“设置”▸“通用”中更改此选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解壓縮會在壓縮檔案旁建立以其命名的檔案夾。你可以在「設定」▸「一般」中更改此選擇。"
          }
        }
      }
