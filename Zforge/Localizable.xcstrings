        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोलने के बाद आर्काइव बदल गया है। आइटम हटाने से पहले इसे फिर से खोलें।"
          }
        },
        "it" : {
          "stringUnit" : {
