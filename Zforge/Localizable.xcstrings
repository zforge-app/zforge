    "Adds a Zforge submenu to Finder's shortcut menu for files, folders and archives. Turn on the Zforge extension in System Settings to use it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফাইল, ফোল্ডার ও আর্কাইভের জন্য Finder-এর শর্টকাট মেনুতে একটি Zforge সাবমেনু যোগ করে। এটি ব্যবহার করতে সিস্টেম সেটিংসে Zforge এক্সটেনশন চালু করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidá do místní nabídky Finderu podnabídku Zforge pro soubory, složky a archivy. Chcete-li ji používat, zapněte rozšíření Zforge v Nastavení systému."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjer en Zforge-undermenu til Finders genvejsmenu for filer, mapper og arkiver. Slå Zforge-udvidelsen til i Systemindstillinger for at bruge den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt dem Kontextmenü des Finder ein Zforge-Untermenü für Dateien, Ordner und Archive hinzu. Aktiviere die Zforge-Erweiterung in den Systemeinstellungen, um es zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a Zforge submenu to Finder's shortcut menu for files, folders and archives. Turn on the Zforge extension in System Settings to use it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un submenú Zforge al menú de función rápida del Finder para archivos, carpetas y archivos comprimidos. Activa la extensión Zforge en Ajustes del Sistema para usarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un sous-menu Zforge au menu contextuel du Finder pour les fichiers, dossiers et archives. Activez l’extension Zforge dans Réglages Système pour l’utiliser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइलों, फ़ोल्डरों और आर्काइव के लिए Finder के शॉर्टकट मेनू में Zforge उपमेनू जोड़ता है। इसका उपयोग करने के लिए सिस्टम सेटिंग्ज़ में Zforge एक्सटेंशन चालू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge un sottomenu Zforge al menu contestuale del Finder per file, cartelle e archivi. Attiva l’estensione Zforge in Impostazioni di Sistema per usarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル、フォルダ、アーカイブ用の Zforge サブメニューを Finder のショートカットメニューに追加します。使用するには、システム設定で Zforge 機能拡張をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일, 폴더 및 아카이브를 위한 Zforge 하위 메뉴를 Finder의 단축 메뉴에 추가합니다. 사용하려면 시스템 설정에서 Zforge 확장 프로그램을 켜십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een Zforge-submenu toe aan het contextuele menu van de Finder voor bestanden, mappen en archieven. Schakel de Zforge-extensie in via Systeeminstellingen om het te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje podmenu Zforge do menu skrótów Findera dla plików, folderów i archiwów. Aby z niego korzystać, włącz rozszerzenie Zforge w Ustawieniach systemowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um submenu Zforge ao menu de atalhos do Finder para arquivos, pastas e arquivos compactados. Ative a extensão Zforge nos Ajustes do Sistema para usá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет подменю Zforge в контекстное меню Finder для файлов, папок и архивов. Чтобы использовать его, включите расширение Zforge в Системных настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till en Zforge-undermeny i Finders kontextmeny för filer, mappar och arkiv. Aktivera Zforge-tillägget i Systeminställningar för att använda den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มเมนูย่อย Zforge ลงในเมนูลัดของ Finder สำหรับไฟล์ โฟลเดอร์ และไฟล์บีบอัด เปิดส่วนขยาย Zforge ในการตั้งค่าระบบเพื่อใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyalar, klasörler ve arşivler için Finder’ın kestirme menüsüne bir Zforge alt menüsü ekler. Kullanmak için Sistem Ayarları’nda Zforge uzantısını açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає підменю Zforge до контекстного меню Finder для файлів, папок і архівів. Щоб користуватися ним, увімкніть розширення Zforge у Системних параметрах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为文件、文件夹和归档在访达的快捷菜单中添加 Zforge 子菜单。要使用它，请在系统设置中打开 Zforge 扩展。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為檔案、檔案夾和封存檔在 Finder 的快速選單中加入 Zforge 子選單。若要使用，請在系統設定中開啟 Zforge 延伸功能。"
          }
        }
      }
    },
