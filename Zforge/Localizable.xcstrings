    "Extracting %@ may require more than 1 GB of temporary disk space." : {
      "comment" : "A confirmation dialog that appears when the user is about to extract a large file from an archive.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ এক্সট্র্যাক্ট করতে 1 GB-এর বেশি অস্থায়ী ডিস্কের জায়গা লাগতে পারে।"
