    "Zforge needs access to %@ for this action. Authorizing this folder also permits future agent and shortcut requests to read and write inside it." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই অ্যাকশনের জন্য Zforge-এর %@ অ্যাক্সেস প্রয়োজন। এই ফোল্ডারের অনুমতি দিলে ভবিষ্যতে এজেন্ট ও শর্টকাটের অনুরোধও এর ভিতরে পড়তে ও লিখতে পারবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge potřebuje pro tuto akci přístup k %@. Povolení této složky umožní i budoucím požadavkům agentů a zkratek číst a zapisovat uvnitř ní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge skal have adgang til %@ for at udføre denne handling. Godkendelse af denne mappe giver også fremtidige anmodninger fra agenter og genveje mulighed for at læse og skrive i den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge benötigt für diese Aktion Zugriff auf %@. Wenn du diesen Ordner freigibst, können auch zukünftige Agenten- und Kurzbefehlanfragen darin lesen und schreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge needs access to %@ for this action. Authorizing this folder also permits future agent and shortcut requests to read and write inside it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge necesita acceder a %@ para esta acción. Autorizar esta carpeta también permite que las futuras solicitudes de agentes y atajos lean y escriban en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge doit accéder à %@ pour cette action. L’autorisation de ce dossier permet aussi aux futures demandes d’agents et de raccourcis d’y lire et d’y écrire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ऐक्शन के लिए Zforge को %@ का ऐक्सेस चाहिए। इस फ़ोल्डर की अनुमति देने से आगे एजेंट और शॉर्टकट अनुरोध भी इसमें पढ़ और लिख सकेंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge deve accedere a %@ per questa azione. Autorizzare questa cartella consente anche alle future richieste di agenti e comandi rapidi di leggere e scrivere al suo interno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアクションには Zforge が%@にアクセスする必要があります。このフォルダを許可すると、今後のエージェントやショートカットからのリクエストでも、フォルダ内の読み書きが許可されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 동작을 수행하려면 Zforge가 %@에 접근해야 합니다. 이 폴더에 권한을 부여하면 향후 에이전트와 단축어 요청에서도 내부 항목을 읽고 쓸 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge heeft voor deze actie toegang tot %@ nodig. Als je deze map toestaat, mogen toekomstige verzoeken van agents en opdrachten er ook lezen en schrijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge potrzebuje dostępu do %@ dla tej czynności. Zezwolenie na ten folder pozwala też przyszłym żądaniom agentów i skrótów na odczyt i zapis w nim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zforge precisa acessar %@ para esta ação. Autorizar esta pasta também permite que futuras solicitações de agentes e atalhos leiam e gravem nela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge требуется доступ к %@ для этого действия. Разрешение этой папки также позволяет будущим запросам агентов и команд читать и записывать данные в ней."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge behöver åtkomst till %@ för den här åtgärden. Om du godkänner den här mappen tillåts även framtida förfrågningar från agenter och genvägar att läsa och skriva i den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge ต้องเข้าถึง %@ สำหรับการทำงานนี้ การอนุญาตโฟลเดอร์นี้ยังอนุญาตให้คำขอจากเอเจนต์และคำสั่งลัดในอนาคตอ่านและเขียนภายในโฟลเดอร์ได้ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge bu eylem için %@ konumuna erişim gerektiriyor. Bu klasöre izin verilmesi, gelecekteki ajan ve kestirme isteklerinin de klasörün içinde okuma ve yazma yapmasına izin verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge потрібен доступ до %@ для цієї дії. Дозвіл для цієї папки також дає майбутнім запитам агентів і швидких команд змогу читати та записувати дані в ній."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge 需要访问 %@ 才能执行此操作。授权此文件夹也将允许未来的代理和快捷指令请求读写其中的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge 需要取用 %@ 才能執行此操作。授權此資料夾也將允許未來的代理和捷徑請求讀寫其中的內容。"
          }
        }
      }
    },
    "Zforge needs your permission to access a folder." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফোল্ডার অ্যাক্সেস করতে Zforge-এর আপনার অনুমতি প্রয়োজন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge potřebuje vaše svolení pro přístup ke složce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge skal have din tilladelse til at få adgang til en mappe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge benötigt deine Erlaubnis, um auf einen Ordner zuzugreifen."
