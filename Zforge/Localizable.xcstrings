          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge требуется ваше разрешение на доступ к папке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge behöver ditt tillstånd för att komma åt en mapp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge ต้องการการอนุญาตจากคุณเพื่อเข้าถึงโฟลเดอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge bir klasöre erişmek için izninize ihtiyaç duyuyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge потрібен ваш дозвіл на доступ до папки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
