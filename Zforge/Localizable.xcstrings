    "No archive directly inside your allowed folders has a name containing “%@”." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যার নামে “%@” আছে এমন কোনো আর্কাইভ আপনার অনুমোদিত ফোল্ডারের সরাসরি ভিতরে নেই।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádný archiv přímo ve vašich povolených složkách nemá v názvu „%@“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet arkiv direkte i dine tilladte mapper har et navn, der indeholder “%@”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Archiv direkt in deinen freigegebenen Ordnern enthält „%@“ im Namen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No archive directly inside your allowed folders has a name containing “%@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún archivo comprimido situado directamente en tus carpetas permitidas contiene «%@» en su nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune archive située directement dans vos dossiers autorisés ne contient « %@ » dans son nom."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके अनुमति वाले फ़ोल्डर में सीधे मौजूद किसी भी आर्काइव के नाम में “%@” नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun archivio presente direttamente nelle cartelle consentite contiene “%@” nel nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可したフォルダ内に直接保存されているアーカイブに、名前に“%@”を含むものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용된 폴더 바로 아래에 이름에 ‘%@’이(가) 포함된 압축 파일이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen archief direct in je toegestane mappen heeft een naam met ‘%@’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żadne archiwum znajdujące się bezpośrednio w dozwolonych folderach nie ma w nazwie „%@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum arquivo compactado diretamente nas pastas autorizadas tem “%@” no nome."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни один архив непосредственно в разрешённых папках не содержит «%@» в имени."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget arkiv direkt i dina tillåtna mappar har ett namn som innehåller ”%@”."
