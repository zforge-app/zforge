    "Zforge needs your permission to browse this location. Access is remembered securely for future windows." : {
      "comment" : "A description of the user's need to grant access to a folder.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই অবস্থান ব্রাউজ করতে Zforge-এর আপনার অনুমতি প্রয়োজন। ভবিষ্যতের উইন্ডোর জন্য অ্যাক্সেস নিরাপদে মনে রাখা হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge potřebuje vaše svolení k procházení tohoto umístění. Přístup se bezpečně zapamatuje pro další okna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge skal have din tilladelse til at gennemse denne placering. Adgangen huskes sikkert til fremtidige vinduer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge benötigt deine Erlaubnis, um diesen Ort zu durchsuchen. Der Zugriff wird für zukünftige Fenster sicher gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge needs your permission to browse this location. Access is remembered securely for future windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge necesita tu permiso para explorar esta ubicación. El acceso se guarda de forma segura para futuras ventanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge a besoin de votre autorisation pour parcourir cet emplacement. L’accès est conservé de façon sécurisée pour les futures fenêtres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस स्थान को ब्राउज़ करने के लिए Zforge को आपकी अनुमति चाहिए। आगे की विंडो के लिए ऐक्सेस सुरक्षित रूप से याद रखा जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge richiede il tuo permesso per esplorare questa posizione. L’accesso viene conservato in modo sicuro per le finestre future."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge がこの場所を表示するには許可が必要です。アクセス権は安全に保存され、今後のウインドウでも使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 위치를 탐색하려면 Zforge에 접근 권한을 부여해야 합니다. 접근 권한은 이후 윈도우에서도 사용할 수 있도록 안전하게 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge heeft je toestemming nodig om deze locatie te bekijken. De toegang wordt veilig onthouden voor toekomstige vensters."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge potrzebuje Twojej zgody na przeglądanie tego miejsca. Dostęp jest bezpiecznie zapamiętywany dla przyszłych okien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zforge precisa da sua permissão para navegar neste local. O acesso será lembrado com segurança para futuras janelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge требуется ваше разрешение на просмотр этого места. Доступ безопасно сохраняется для будущих окон."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge behöver ditt tillstånd för att bläddra på den här platsen. Åtkomsten sparas säkert för framtida fönster."
          }
        },
        "th" : {
