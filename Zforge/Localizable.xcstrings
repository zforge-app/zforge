        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "압축 파일이 열린 이후 변경되었습니다. 항목을 제거하기 전에 다시 여십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
