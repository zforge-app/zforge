    "Allow Zforge in System Settings ▸ Privacy & Security ▸ Local Network to find servers." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সার্ভার খুঁজতে সিস্টেম সেটিংস ▸ গোপনীয়তা ও নিরাপত্তা ▸ লোকাল নেটওয়ার্ক-এ Zforge-কে অনুমতি দিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li hledat servery, povolte Zforge v Nastavení systému ▸ Soukromí a zabezpečení ▸ Místní síť."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad Zforge under Systemindstillinger ▸ Anonymitet og sikkerhed ▸ Lokalt netværk for at finde servere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Zforge unter „Systemeinstellungen ▸ Datenschutz & Sicherheit ▸ Lokales Netzwerk“, um Server zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Zforge in System Settings ▸ Privacy & Security ▸ Local Network to find servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite Zforge en Ajustes del Sistema ▸ Privacidad y seguridad ▸ Red local para encontrar servidores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Zforge dans Réglages Système ▸ Confidentialité et sécurité ▸ Réseau local pour trouver des serveurs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर खोजने के लिए सिस्टम सेटिंग्ज़ ▸ गोपनीयता और सुरक्षा ▸ लोकल नेटवर्क में Zforge को अनुमति दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti Zforge in Impostazioni di Sistema ▸ Privacy e sicurezza ▸ Rete locale per trovare i server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバを探すには、システム設定 ▸ プライバシーとセキュリティ ▸ ローカルネットワークで Zforge を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버를 찾으려면 시스템 설정 ▸ 개인정보 보호 및 보안 ▸ 로컬 네트워크에서 Zforge를 허용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Zforge toe in Systeeminstellingen ▸ Privacy en beveiliging ▸ Lokaal netwerk om servers te vinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby znaleźć serwery, zezwól na Zforge w Ustawieniach systemowych ▸ Prywatność i ochrona ▸ Sieć lokalna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o Zforge em Ajustes do Sistema ▸ Privacidade e Segurança ▸ Rede Local para encontrar servidores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы найти серверы, разрешите Zforge в разделе «Системные настройки ▸ Конфиденциальность и безопасность ▸ Локальная сеть»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt Zforge i Systeminställningar ▸ Integritet och säkerhet ▸ Lokalt nätverk för att hitta servrar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาต Zforge ในการตั้งค่าระบบ ▸ ความเป็นส่วนตัวและความปลอดภัย ▸ เครือข่ายเฉพาะที่ เพื่อค้นหาเซิร์ฟเวอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucuları bulmak için Sistem Ayarları ▸ Gizlilik ve Güvenlik ▸ Yerel Ağ bölümünde Zforge’a izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб знайти сервери, дозвольте Zforge у розділі «Системні параметри ▸ Приватність і безпека ▸ Локальна мережа»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”▸“隐私与安全性”▸“本地网络”中允许 Zforge 以查找服务器。"
          }
        },
        "zh-Hant" : {
