          "stringUnit" : {
            "state" : "translated",
            "value" : "An item in a solid block is measured by the compressed size of its block."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ítem de un bloque sólido se mide por el tamaño comprimido de su bloque."
