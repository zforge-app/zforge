        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 자동화 작업이 실행 중입니다. 완료될 때까지 기다리거나 취소하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
