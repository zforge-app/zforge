    "Cannot complete this operation because an item named %@ already exists." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ নামের আইটেম আগে থেকেই আছে বলে এই কাজ সম্পূর্ণ করা যাচ্ছে না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operaci nelze dokončit, protože položka s názvem %@ už existuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlingen kan ikke udføres, fordi der allerede findes et emne med navnet %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Vorgang kann nicht abgeschlossen werden, weil bereits ein Objekt namens %@ vorhanden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cannot complete this operation because an item named %@ already exists."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede completar esta operación porque ya existe un ítem llamado %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette opération ne peut pas être terminée car un élément nommé %@ existe déjà."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ नाम का आइटम पहले से मौजूद है, इसलिए यह कार्य पूरा नहीं हो सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile completare l’operazione perché esiste già un elemento chiamato %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@という名前の項目がすでに存在するため、この操作を完了できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 항목이 이미 있어 이 작업을 완료할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze bewerking kan niet worden voltooid omdat er al een onderdeel met de naam %@ bestaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można ukończyć tej operacji, ponieważ rzecz o nazwie %@ już istnieje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível concluir esta operação porque já existe um item chamado %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось завершить операцию: объект с именем %@ уже существует."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtgärden kan inte slutföras eftersom det redan finns ett objekt med namnet %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถทำงานนี้ให้เสร็จได้ เนื่องจากมีรายการชื่อ %@ อยู่แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adlı bir öğe zaten olduğu için bu işlem tamamlanamıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося завершити операцію, оскільки об’єкт із назвою %@ вже існує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法完成此操作，因为已存在名为 %@ 的项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法完成此操作，因為已存在名為 %@ 的項目。"
