    "Writing the inner archive back would replace those changes. You can save the inner archive separately or discard its changes." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অভ্যন্তরীণ আর্কাইভটি আবার লিখলে সেই পরিবর্তনগুলো প্রতিস্থাপিত হবে। আপনি অভ্যন্তরীণ আর্কাইভটি আলাদাভাবে সংরক্ষণ করতে বা এর পরিবর্তনগুলো বাতিল করতে পারেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapsáním vnitřního archivu zpět by se tyto změny nahradily. Vnitřní archiv můžete uložit samostatně nebo jeho změny zahodit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis det indre arkiv skrives tilbage, erstattes disse ændringer. Du kan arkivere det indre arkiv separat eller kassere dets ændringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird das innere Archiv zurückgeschrieben, werden diese Änderungen ersetzt. Du kannst das innere Archiv separat sichern oder seine Änderungen verwerfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writing the inner archive back would replace those changes. You can save the inner archive separately or discard its changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribir de nuevo el archivo interno reemplazaría esos cambios. Puedes guardar el archivo interno por separado o descartar sus cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réécrire l’archive interne remplacerait ces modifications. Vous pouvez enregistrer l’archive interne séparément ou ignorer ses modifications."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भीतरी आर्काइव को वापस लिखने से वे बदलाव बदल जाएँगे। आप भीतरी आर्काइव को अलग से सहेज सकते हैं या उसके बदलाव छोड़ सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riscrivere l’archivio interno sostituirebbe quelle modifiche. Puoi salvare l’archivio interno separatamente o annullarne le modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内部アーカイブを書き戻すと、それらの変更が置き換えられます。内部アーカイブを別に保存するか、その変更を破棄できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내부 압축 파일을 다시 쓰면 해당 변경 사항이 대치됩니다. 내부 압축 파일을 별도로 저장하거나 변경 사항을 폐기할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het binnenarchief wordt teruggeschreven, worden die wijzigingen vervangen. Je kunt het binnenarchief apart bewaren of de wijzigingen ervan weggooien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisanie archiwum wewnętrznego z powrotem zastąpiłoby te zmiany. Możesz zachować archiwum wewnętrzne osobno lub odrzucić jego zmiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gravar o arquivo compactado interno de volta substituiria essas alterações. Você pode salvar o arquivo compactado interno separadamente ou descartar as alterações dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись вложенного архива обратно заменит эти изменения. Можно сохранить вложенный архив отдельно или отменить его изменения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om det inre arkivet skrivs tillbaka ersätts de ändringarna. Du kan spara det inre arkivet separat eller ignorera dess ändringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเขียนไฟล์บีบอัดภายในกลับจะแทนที่การเปลี่ยนแปลงเหล่านั้น คุณสามารถบันทึกไฟล์บีบอัดภายในแยกต่างหาก หรือละทิ้งการเปลี่ยนแปลงของไฟล์นั้นได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İç arşivi yeniden yazmak bu değişikliklerin yerini alır. İç arşivi ayrı olarak kaydedebilir veya değişikliklerini atabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запис вкладеного архіву назад замінить ці зміни. Можна зберегти вкладений архів окремо або відкинути його зміни."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写回内部压缩文件会替换这些更改。你可以单独存储内部压缩文件，或放弃其更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫回內部壓縮檔案會取代這些更改。你可以單獨儲存內部壓縮檔案，或放棄其更改。"
          }
        }
      }
    },
