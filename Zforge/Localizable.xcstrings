    "archive.missing_volume %@" : {
      "comment" : "Error when a volume of a split archive (for example Backup.7z.002 or Backup.z01) is not in the archive's folder. The argument is the missing volume's file name.",
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই বিভক্ত আর্কাইভের ভলিউম “%@” পাওয়া যায়নি। এর সব ভলিউম একই ফোল্ডারে রেখে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svazek „%@“ tohoto rozděleného archivu chybí. Umístěte všechny jeho svazky do stejné složky a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delen “%@” af dette opdelte arkiv mangler. Læg alle arkivets dele i den samme mappe, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Volume „%@“ dieses geteilten Archivs fehlt. Lege alle Volumes in denselben Ordner und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The volume “%@” of this split archive is missing. Put all of its volumes in the same folder and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el volumen “%@” de este archivo comprimido dividido. Coloca todos sus volúmenes en la misma carpeta e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le volume « %@ » de cette archive fractionnée est introuvable. Placez tous ses volumes dans le même dossier, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस विभाजित आर्काइव का वॉल्यूम “%@” नहीं मिला। इसके सभी वॉल्यूम एक ही फ़ोल्डर में रखें और फिर से कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca il volume “%@” di questo archivio diviso. Metti tutti i suoi volumi nella stessa cartella e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この分割アーカイブのボリューム“%@”が見つかりません。すべてのボリュームを同じフォルダに置いてから、もう一度試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 분할 압축 파일의 볼륨 ‘%@’을(를) 찾을 수 없습니다. 모든 볼륨을 같은 폴더에 넣은 다음 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het volume ‘%@’ van dit gesplitste archief ontbreekt. Zet alle volumes in dezelfde map en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje woluminu „%@” tego podzielonego archiwum. Umieść wszystkie jego woluminy w tym samym folderze i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O volume “%@” deste arquivo compactado dividido não foi encontrado. Coloque todos os volumes na mesma pasta e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не найден том «%@» этого разделённого архива. Поместите все его тома в одну папку и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volymen ”%@” i det här delade arkivet saknas. Lägg alla dess volymer i samma mapp och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบโวลุ่ม “%@” ของไฟล์บีบอัดแบบแบ่งนี้ โปรดวางโวลุ่มทั้งหมดไว้ในโฟลเดอร์เดียวกัน แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bölünmüş arşivin “%@” parçası eksik. Tüm parçalarını aynı klasöre koyup yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не знайдено том «%@» цього розділеного архіву. Покладіть усі його томи в одну папку й повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到此分卷压缩文件的分卷“%@”。请将所有分卷放在同一个文件夹中，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到此分卷壓縮檔案的分卷「%@」。請將所有分卷放在同一個檔案夾中，然後再試一次。"
          }
        }
      }
    },
