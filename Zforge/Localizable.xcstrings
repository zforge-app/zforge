    "The archive changed since it was opened. Reopen it before removing items." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "খোলার পর আর্কাইভ বদলেছে। আইটেম সরানোর আগে আবার খুলুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiv se od otevření změnil. Před odebíráním položek ho znovu otevřete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkivet er blevet ændret, siden det blev åbnet. Åbn det igen, før du fjerner emner."
