            "state" : "translated",
            "value" : "Zforge a besoin de votre autorisation pour accéder à un dossier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोल्डर का ऐक्सेस लेने के लिए Zforge को आपकी अनुमति चाहिए।"
          }
        },
        "it" : {
