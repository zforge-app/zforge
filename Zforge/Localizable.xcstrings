    "Passwords stay in memory for this session and are never saved in profiles." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সেশনে পাসওয়ার্ড মেমরিতে থাকবে এবং কখনও প্রোফাইলে সংরক্ষিত হবে না।"
          }
        },
        "cs" : {
