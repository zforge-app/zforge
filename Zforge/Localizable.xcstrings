            "state" : "translated",
            "value" : "चयन से फ़ोल्डर बनाने के लिए एक ही फ़ोल्डर के आइटम चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona elementi della stessa cartella per creare una cartella con la selezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択項目からフォルダを作成するには、同じフォルダ内の項目を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 항목으로 폴더를 생성하려면 같은 폴더의 항목을 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecteer onderdelen uit dezelfde map om een map met selectie aan te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby utworzyć folder z zaznaczeniem, zaznacz rzeczy z tego samego folderu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione itens da mesma pasta para criar uma pasta com a seleção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы создать папку с выбранными объектами, выберите объекты из одной папки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markera objekt från samma mapp för att skapa en mapp med markering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกรายการจากโฟลเดอร์เดียวกันเพื่อสร้างโฟลเดอร์จากรายการที่เลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçimle klasör oluşturmak için aynı klasördeki öğeleri seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб створити папку з вибраним, виберіть об’єкти з однієї папки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请从同一文件夹选择项目，才能用所选项目新建文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請從同一資料夾選擇項目，才能用所選項目新建資料夾。"
          }
        }
      }
    },
    "Select the requested folder to continue. A different or broader folder cannot authorize this request." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চালিয়ে যেতে অনুরোধ করা ফোল্ডার বেছে নিন। অন্য কোনও ফোল্ডার বা তার ঊর্ধ্বতন ফোল্ডারের অনুমতি এই অনুরোধের জন্য প্রযোজ্য নয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li pokračovat, vyberte požadovanou složku. Jiná nebo širší složka nemůže tento požadavek autorizovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg den ønskede mappe for at fortsætte. En anden eller mere omfattende mappe kan ikke godkende denne anmodning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle den angeforderten Ordner, um fortzufahren. Ein anderer oder übergeordneter Ordner kann diese Anfrage nicht autorisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select the requested folder to continue. A different or broader folder cannot authorize this request."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona la carpeta solicitada para continuar. Una carpeta diferente o superior no puede autorizar esta solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez le dossier demandé pour continuer. Un autre dossier ou un dossier parent ne peut pas autoriser cette demande."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जारी रखने के लिए अनुरोधित फ़ोल्डर चुनें। किसी दूसरे फ़ोल्डर या उसके ऊपरी फ़ोल्डर की अनुमति इस अनुरोध के लिए मान्य नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona la cartella richiesta per continuare. Una cartella diversa o superiore non può autorizzare questa richiesta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定されたフォルダを選択して続けてください。別のフォルダや上位のフォルダでは、このリクエストを許可できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속하려면 요청된 폴더를 선택하십시오. 다른 폴더 또는 상위 폴더로는 이 요청에 권한을 부여할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecteer de gevraagde map om door te gaan. Een andere of bovenliggende map kan dit verzoek niet autoriseren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz żądany folder, aby kontynuować. Inny lub szerszy folder nie może autoryzować tego żądania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione a pasta solicitada para continuar. Uma pasta diferente ou mais abrangente não pode autorizar esta solicitação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите запрошенную папку для продолжения. Другая или более широкая папка не может разрешить этот запрос."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markera den begärda mappen för att fortsätta. En annan eller överordnad mapp kan inte godkänna den här förfrågan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกโฟลเดอร์ที่ร้องขอเพื่อดำเนินการต่อ โฟลเดอร์อื่นหรือโฟลเดอร์ที่ครอบคลุมกว่านี้ไม่สามารถอนุญาตคำขอนี้ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürdürmek için istenen klasörü seçin. Farklı veya daha kapsamlı bir klasör bu isteğe izin veremez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть запитану папку, щоб продовжити. Інша або ширша папка не може авторизувати цей запит."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择请求的文件夹以继续。其他文件夹或范围更大的文件夹无法授权此请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇請求的資料夾以繼續。其他資料夾或範圍更大的資料夾無法授權此請求。"
          }
        }
      }
    },
