          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge potrzebuje Twojej zgody na dostęp do folderu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
