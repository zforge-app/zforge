          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge가 폴더에 접근하려면 사용자의 권한이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
