    "Another automation operation is running. Wait for it to finish or cancel it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অন্য একটি অটোমেশন কাজ চলছে। সেটি শেষ হওয়া পর্যন্ত অপেক্ষা করুন বা বাতিল করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probíhá jiná operace automatizace. Počkejte na její dokončení nebo ji zrušte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden automatiseringshandling er i gang. Vent, til den er færdig, eller annuller den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderer Automatisierungsvorgang läuft bereits. Warte, bis er abgeschlossen ist, oder brich ihn ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another automation operation is running. Wait for it to finish or cancel it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
