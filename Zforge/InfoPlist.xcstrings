      "comment" : "Local Network privacy prompt shown before Zforge browses for servers (Network level).",
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge আপনার লোকাল নেটওয়ার্কে ফাইল সার্ভার খোঁজে, যাতে সেগুলো নেটওয়ার্ক-এ দেখানো যায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge hledá v místní síti souborové servery, aby je mohl zobrazit v části Síť."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge leder efter filservere på dit lokale netværk for at vise dem under Netværk."
