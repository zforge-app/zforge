        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge sucht in deinem lokalen Netzwerk nach Dateiservern, um sie unter „Netzwerk“ anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zforge looks for file servers on your local network to list them in Network."
